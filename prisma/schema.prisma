generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid()) @db.VarChar(36)
  email            String    @unique
  password         String
  displayName      String
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  tastings Tasting[]
}

model Tasting {
  id            String   @id @default(uuid()) @db.VarChar(36)
  /// Per-user display number ("No. 1", "No. 2"). Starts at 1 for every account and is
  /// what the UI shows — the uuid id is never surfaced.
  number        Int
  userId        String   @db.VarChar(36)
  wineType      String?
  sight         Json?
  nose          Json?
  palate        Json?
  conclusion    Json?
  wineName      String?
  timerEnabled  Boolean  @default(false)
  timerDuration Int?
  isArchived    Boolean  @default(false)
  notes         String?
  created_at    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  /// Makes the per-user numbering race-safe: a concurrent insert that picks the same
  /// number fails the constraint instead of silently duplicating.
  @@unique([userId, number])
}
