# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/blind_tasting"

# Signs the auth cookie. Generate with: openssl rand -base64 48
JWT_SECRET=""

# Password-reset email. Only the reset flow needs these.
RESEND_API_KEY=""
# Optional — sends all reset mail here instead of the real address, for local testing.
RESEND_TEST_EMAIL=""

# Base URL used to build password-reset links.
NEXT_PUBLIC_APP_URL="http://localhost:3002"
