# Postgres connection string. Prefix the host with your username and password
# if your server requires them.
DATABASE_URL="postgresql://localhost:5432/blind_tasting"

# Signs the auth cookie. Generate with: openssl rand -base64 48
JWT_SECRET=""

# Password-reset email. Only the reset flow needs these.
RESEND_API_KEY=""
# Optional — sends all reset mail here instead of the real address, for local testing.
RESEND_TEST_EMAIL=""

# Base URL used to build password-reset links.
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Where label photos are stored: "local" (default) writes under UPLOAD_DIR and needs a host with a
# persistent disk; "r2" uploads straight from the browser to a private Cloudflare R2 bucket.
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Cloudflare R2, only when STORAGE_DRIVER="r2". The bucket needs a CORS rule allowing PUT with a
# Content-Type header from NEXT_PUBLIC_APP_URL, since the browser uploads to it directly.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
